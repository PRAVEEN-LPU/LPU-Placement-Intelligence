# ==============================================================================
# Production Environment Variables for Vite Frontend (Vercel / Netlify / Render)
# ==============================================================================

# OPTION 1: If Backend is deployed on Render (Copy and paste this into Vercel)
# Replace with your actual Render service URL:
# VITE_API_BASE_URL=https://lpu-placement-intelligence-backend.onrender.com/api

# OPTION 2: If deploying both Frontend & Backend together on Vercel (monorepo):
VITE_API_BASE_URL=/api

# Production build telemetry and feedback flags
VITE_BUILD_ID=production
VITE_PILOT_FEEDBACK=off
