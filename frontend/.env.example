# ==============================================================================
# Frontend Environment Variables Template (Vite)
# ==============================================================================
# Only VITE_* values are exposed to the browser: never put secrets here.

# Local Development proxy target:
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# ------------------------------------------------------------------------------
# Direct Copy-Paste for Vercel / Production Deployments:
# ------------------------------------------------------------------------------
# Case A: When Backend is hosted on Render:
# VITE_API_BASE_URL=https://lpu-placement-intelligence-backend.onrender.com/api

# Case B: When Full-Stack is hosted on Vercel:
VITE_API_BASE_URL=/api

# Production flags:
VITE_BUILD_ID=production
VITE_PILOT_FEEDBACK=off

# ------------------------------------------------------------------------------
# Optional Cloud / Telemetry (Keep commented unless configured):
# ------------------------------------------------------------------------------
# VITE_AUTH_PROVIDER=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# VITE_TELEMETRY_ENDPOINT=https://telemetry.example.edu/v1/events
